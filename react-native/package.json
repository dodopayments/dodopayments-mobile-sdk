{
  "name": "@dodopayments/react-native-checkout",
  "version": "1.0.0",
  "description": "Open Dodo Payments' hosted checkout in a system browser tab from React Native.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/src/index.d.ts",
  "react-native": "src/index.tsx",
  "source": "src/index.tsx",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "app.plugin.js",
    "DodoCheckoutReactNative.podspec",
    "!**/__tests__",
    "!**/.*",
    "!android/build",
    "!android/.gradle",
    "!android/local.properties"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "keywords": ["dodopayments", "checkout", "payments", "react-native"],
  "license": "Apache-2.0",
  "homepage": "https://github.com/dodopayments/dodopayments-checkout-react-native",
  "publishConfig": {
    "access": "public"
  },
  "codegenConfig": {
    "name": "DodoCheckoutSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.dodopayments.reactnative"
    },
    "ios": {
      "modulesProvider": {
        "DodoCheckout": "DodoCheckout"
      }
    }
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.76.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/react": "^19.1.0",
    "jest": "^29.7.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "ts-jest": "^29.1.2",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "modulePathIgnorePatterns": ["<rootDir>/example/node_modules", "<rootDir>/lib/"]
  }
}
