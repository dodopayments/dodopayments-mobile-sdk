{
  "name": "@dodopayments/react-native-checkout",
  "version": "1.1.1",
  "description": "Open Dodo Payments' hosted checkout in a system browser tab from React Native.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.tsx",
  "source": "src/index.tsx",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "app.plugin.js",
    "CHANGELOG.md",
    "DodoCheckoutReactNative.podspec",
    "!**/__tests__",
    "!**/.*",
    "!android/build",
    "!android/.gradle",
    "!android/local.properties"
  ],
  "scripts": {
    "build": "bob build",
    "prepare": "bob build",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "keywords": [
    "dodopayments",
    "checkout",
    "payments",
    "react-native"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/dodopayments/dodopayments-mobile-sdk/tree/main/react-native",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dodopayments/dodopayments-mobile-sdk.git",
    "directory": "react-native"
  },
  "bugs": {
    "url": "https://github.com/dodopayments/dodopayments-mobile-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "DodoCheckoutSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.dodopayments.reactnative"
    },
    "ios": {
      "modulesProvider": {
        "DodoCheckout": "DodoCheckout"
      }
    }
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.77.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/react": "^19.1.0",
    "jest": "^29.7.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-builder-bob": "^0.43.0",
    "ts-jest": "^29.1.2",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.(test|spec).(ts|tsx|js)"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  }
}
